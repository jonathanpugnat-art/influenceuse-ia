# Drivers (fs local by default; production must be db + r2)
METADATA_DRIVER=fs
BLOB_DRIVER=fs

# Neon Postgres (EU region, e.g. aws-eu-central-1)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cloudflare R2 (jurisdiction EU)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_JURISDICTION=eu

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# Replicate
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SIGNING_SECRET=
APP_BASE_URL=http://localhost:3000

# Observability (EU)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Product
CREDITS_ENFORCED=false
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
INITIAL_CREDITS=30
PREVIEW_TTL_HOURS=48

# P3 identity (optional; off by default)
IDENTITY_SCORING_ENABLED=false
FACE_EMBED_MODEL=
IDENTITY_SCORE_PASS=0.7
IDENTITY_SCORE_WARN=0.55
IDENTITY_AUTO_RETRY_MAX=1
IDENTITY_REFS_ENABLED=false
LORA_ENABLED=false
REPLICATE_LORA_DESTINATION=
REPLICATE_FAST_FLUX_TRAINER_VERSION=

# Stripe (required when BILLING_ENABLED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Prefer new keys; legacy STRIPE_*_PRICE_ID still accepted
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_AGENCE=
STRIPE_PRICE_PACK_SMALL=
STRIPE_PRICE_PACK_MEDIUM=
STRIPE_PRICE_PACK_LARGE=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Existing
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# DEEPSEEK_API_KEY=
# APIFY_TOKEN=
