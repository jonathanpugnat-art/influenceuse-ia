# Base de données (Postgres)
# - DATABASE_URL: pooled connection (PgBouncer / Neon pooler) used by the
#   Next.js runtime so serverless functions share connections.
# - DIRECT_URL: direct connection used by `prisma migrate deploy` at
#   build-time. Required when the pooled URL is in transaction mode
#   (PgBouncer/pooler) because Prisma Migrate uses prepared statements.
#   In local dev, leave DIRECT_URL unset → falls back to DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influenceuse"
DIRECT_URL=""

# Clerk (authentification)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/fr/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/fr/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/fr/influencers"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/fr/influencers"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENCRYPTION_SECRET=
CRON_SECRET=

# ──────────────────────────────────────────────
# Closed beta (v0.11)
# ──────────────────────────────────────────────
# When true, /api/webhooks/clerk rejects any sign-up whose email is not
# on the waitlist with status INVITED. Set to "true" in production once
# the waitlist UX is live; leave empty/false during local development so
# you can sign up freely.
BETA_REQUIRE_INVITE=

# Comma-separated list of admin emails (case-insensitive). These users
# can access /[locale]/admin/waitlist and call admin.* tRPC procedures.
# Match is against the Clerk primary email (verified at sign-up).
# Example: ADMIN_EMAILS="you@example.com, ops@example.com"
ADMIN_EMAILS=

# Hide every paid-plan / upgrade CTA in the dashboard while Stripe is still
# in TEST mode (no SIRET, no LIVE keys yet). When "true":
#   - Pricing cards show "Bêta gratuite" instead of "Upgrade" buttons.
#   - The low-balance banner hides its upgrade link.
#   - The post-error upgrade modal stops auto-opening.
#   - The billing page swaps the credit-pack grid for an info banner.
# Set the NEXT_PUBLIC_ mirror so Client Components see the same value.
# Paid beta: set both to false when Stripe LIVE is ready (Upgrade CTAs + checkout).
BETA_HIDE_PAYMENTS=false
NEXT_PUBLIC_BETA_HIDE_PAYMENTS=false

# DeepSeek (génération de texte — compatible API OpenAI)
DEEPSEEK_API_KEY=

# Anthropic (provider texte alternatif — fidélité JSON Plan / Idées)
ANTHROPIC_API_KEY=
# Optionnel : modèle Claude utilisé (défaut: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Provider de texte par défaut (deepseek | anthropic). Défaut = deepseek.
# AI_TEXT_PROVIDER=deepseek

# ── Lane adulte / OnlyFans — texte uncensored (DeepSeek ou OpenRouter) ──
# Quand isNsfw / niche ADULT / brief OF → jamais Claude (évite les refus provider).
# deepseek | openrouter
ADULT_TEXT_PROVIDER=deepseek
# Modèle DeepSeek pour agents adulte (défaut: deepseek-chat)
# ADULT_DEEPSEEK_MODEL=deepseek-chat
# OpenRouter (alternative) — https://openrouter.ai
OPENROUTER_API_KEY=
# ADULT_OPENROUTER_MODEL=deepseek/deepseek-chat
# Provider SFW pour agents (anthropic | deepseek). Défaut = anthropic si clé présente.
# AI_AGENT_SFW_PROVIDER=anthropic

# Personnalisation trends (feed / carte) — SFW uniquement (Haiku par défaut).
# Comptes NSFW → backend adulte (DeepSeek / OpenRouter), jamais Claude.
# TREND_PERSONALIZATION_MODEL=claude-haiku-4-5-20251001

# P0 refresh script: npx tsx scripts/p0-refresh-trends.ts
# TRENDS_FORMAT_ANALYZE_LIMIT=30

# Replicate (génération d'images et vidéos)
REPLICATE_API_TOKEN=

# ── Premium / OnlyFans lane — FLUX uncensored ──
# auto = self-host GPU (si PREMIUM_SELFHOST_URL) → Replicate → Together
# selfhost | replicate | together
PREMIUM_IMAGE_PROVIDER=auto
# Modèle Replicate uncensored (fallback cloud si pas de GPU)
# PREMIUM_REPLICATE_MODEL=aisha-ai-official/flux.1dev-uncensored-msfluxnsfw-v3
TOGETHER_API_KEY=
# ── Self-host pro (ComfyUI / Forge / RunPod) — RECOMMANDÉ pour NSFW pro ──
# Handler HTTP POST JSON → { url } ou { urls }
# Checkpoint Civitai suggérés côté GPU : Pony Diffusion XL, Juggernaut XL, Illustrious
# PREMIUM_SELFHOST_URL=https://your-gpu.runpod.ai/generate
# Libellé affiché dans les logs (optionnel)
# PREMIUM_SELFHOST_MODEL_LABEL=pony-diffusion-xl-v6

# ── Novita InstantID — face-lock tier explicit (NSFW + visage verrouillé) ──
# Replicate PuLID couvre suggestive/soft ; Novita InstantID couvre l'explicit
# (SDXL uncensored + visage de réf). Sans clé, l'explicit retombe sur le T2I
# uncensored sans verrouillage de visage.
# NOVITA_API_KEY=
# Checkpoint SDXL réaliste NSFW (voir bibliothèque de modèles Novita)
# PREMIUM_NOVITA_MODEL=epicrealismXL_v10_247189.safetensors
# Force de l'identité InstantID 0–1 (défaut 0.72 — moins « collé » / plastique)
# PREMIUM_NOVITA_ID_STRENGTH=0.72
# Force IP-Adapter visage 0–1 (défaut 0.75)
# PREMIUM_NOVITA_ADAPTER_STRENGTH=0.75
# Steps d'échantillonnage (défaut 40, plage 20–60 ; plus = plus de détail)
# PREMIUM_NOVITA_STEPS=40
# Guidance CFG (défaut 4.0 ; plus bas = moins « cramé »)
# PREMIUM_NOVITA_GUIDANCE=4.0
# Sampler (défaut DPM++ 2M Karras)
# PREMIUM_NOVITA_SAMPLER=DPM++ 2M Karras

# ── Upscaling de finition Premium (NSFW) — OFF par défaut ──
# ESRGAN pur : agrandit + affine sans altérer l'anatomie ni le visage,
# et ne déclenche aucun filtre de contenu. Fail-open (garde l'original si échec).
# PREMIUM_UPSCALE=on
# PREMIUM_UPSCALE_MODEL=nightmareai/real-esrgan
# Facteur d'agrandissement (défaut 2, plage 2–4)
# PREMIUM_UPSCALE_SCALE=2

# Modération post-génération (anti-porno) — Sightengine recommandé en prod
# https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# auto | sightengine | off — auto = Sightengine si clés présentes
PREMIUM_IMAGE_MODERATION=auto

# ── Kill switches launch (incident prod : couper une lane sans hotfix) ──
# DISABLE_PREMIUM_IMAGES=true   # coupe la génération Premium/NSFW (Social reste actif)
# DISABLE_REELS=true            # coupe la génération de reels (photos restent actives)

# Fallback FAL pour Kontext (face-lock) si Replicate est down.
# Actif dès que FAL_KEY est présent ; IMAGE_T2I_PROVIDER=replicate le désactive.
# FAL_KONTEXT_MODEL=fal-ai/flux-pro/kontext
# Seuils 0–1 (défaut raw=0.55, partial=0.82)
# PREMIUM_MODERATION_RAW_THRESHOLD=0.55
# PREMIUM_MODERATION_PARTIAL_THRESHOLD=0.82

# ── Image T2I multi-provider (Phase 1: FLUX scene plates + fallback wizard) ──
# FAL.ai — FLUX 1.1 Pro (prioritaire quand IMAGE_T2I_PROVIDER=auto|fal)
FAL_KEY=
# Wizard step 2 live preview uses fal-ai/flux/schnell (requires FAL_KEY).
# auto | fal | replicate — auto = FAL si FAL_KEY, sinon Replicate
IMAGE_T2I_PROVIDER=auto
# Modèle FAL pour le T2I pur (décor scene-first, portrait wizard fallback)
# FAL_FLUX_T2I_MODEL=fal-ai/flux-pro/v1.1
# FAL_FLUX_T2I_MODEL=fal-ai/flux-pro/v1.1-ultra

# ── Moteur SFW à référence (photos de contenu avec visage verrouillé) ──
# Défaut = seedream (ByteDance Seedream 4 : peau/cheveux/lumière plus réalistes,
# multi-référence 1-10 images, jusqu'à 4K). Repli instantané sur l'ancien
# moteur Nano Banana avec SFW_IMAGE_MODEL=nano (aucun redéploiement requis).
# SFW_IMAGE_MODEL=seedream

# Reels I2V — Kling v3 Standard via FAL (prioritaire si FAL_KEY)
# auto | fal | replicate
VIDEO_I2V_PROVIDER=auto
# FAL_KLING_I2V_MODEL=fal-ai/kling-video/v3/standard/image-to-video
# P1 — Kling Motion Control (trend reels)
# FAL_KLING_MOTION_MODEL=fal-ai/kling-video/v2.6/standard/motion-control
# P1 — LoRA training + generation
# FAL_LORA_TRAINER_MODEL=fal-ai/flux-lora-fast-training
# FAL_FLUX_LORA_MODEL=fal-ai/flux-lora
# LORA_TRAINING_STEPS=500
# REPLICATE_LORA_TRAINER=ostris/flux-dev-lora-trainer:...
# REPLICATE_FLUX_LORA_MODEL=black-forest-labs/flux-dev-lora
# Skip Flux LoRA for complex indoor/outdoor scenes → Kontext + ref (A/B test).
# LORA_SKIP_COMPLEX_SCENES=true

# P1 — Trends: download source MP4 from Apify for motion-control reels
# TRENDS_DOWNLOAD_VIDEOS=true
# Download TikTok covers via Apify (stable URLs; default on — set false to skip)
# TRENDS_DOWNLOAD_COVERS=true

# Variante Pro (Agency) : fal-ai/kling-video/v3/pro/image-to-video

# Optionnel — override par preset (priorité la plus haute)
# REPLICATE_VIDEO_MODEL_STABLE_FACE=kwaivgi/kling-v2.0
# REPLICATE_VIDEO_MODEL_NATURAL_MOTION=wan-video/wan-2.5-i2v
# REPLICATE_VIDEO_MODEL_CREATIVE=runwayml/gen4-aleph
# Optionnel — override global (dernier recours ; évite minimax/video-01 ici :
# il forçait tous les reels sur MiniMax au lieu de Wan/Kling par défaut)
# REPLICATE_VIDEO_MODEL=wan-video/wan-2.5-i2v
# REPLICATE_VIDEO_MODEL_CREATIVE=runwayml/gen4-aleph
# Optionnel — Sprint 10: post-process lip-sync (preset reelStylePreset=lip_sync)
# REPLICATE_LIPSYNC_MODEL=sync/sync-1.6.0
# Optionnel — TTS pour Reels parlants (défaut: jaaari/kokoro-82m)
# REPLICATE_TTS_MODEL=jaaari/kokoro-82m

# Stripe (paiements) — un Price ID par plan payant
# STARTER (Aura.AI Starter)  29 €/mois
# PRO     (Aura.AI Pro)      79 €/mois
# ENTERPRISE (Aura.AI Elite) 199 €/mois
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=
# Sprint 7 — Add-ons : packs de crédits (achat unique)
STRIPE_CREDIT_PACK_SMALL_PRICE_ID=
STRIPE_CREDIT_PACK_MEDIUM_PRICE_ID=
STRIPE_CREDIT_PACK_LARGE_PRICE_ID=

# ──────────────────────────────────────────────
# Auto-publication réseaux sociaux
# ──────────────────────────────────────────────
# Le code de publication (Instagram Graph API v21, TikTok Content Posting API v2)
# est fonctionnel — mais SANS les credentials ci-dessous, le clic
# "Connecter Instagram / TikTok" lèvera "INSTAGRAM_APP_ID non configuré".
#
# Instagram OAuth — mode par défaut : connexion directe Instagram (sans Page Facebook)
# instagram | facebook
INSTAGRAM_OAUTH_MODE=instagram
#
# Instagram Login (recommandé) — IDs dans Meta → Instagram → Business login settings
INSTAGRAM_LOGIN_APP_ID=
INSTAGRAM_LOGIN_APP_SECRET=
# Fallback / mode facebook :
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Obligatoire si ton app Meta utilise "Facebook Login for Business" (erreur Invalid Scopes sinon).
# Meta → Facebook Login for Business → Configurations → config Instagram (jeton utilisateur) → ID
FACEBOOK_LOGIN_CONFIG_ID=
# Force l'erreur explicite si config_id manquant (recommandé pour Login for Business)
# INSTAGRAM_REQUIRE_LOGIN_CONFIG_ID=true
# Alternative : utiliser directement les credentials Facebook si l'app
# n'est pas séparée (le service Instagram lit FACEBOOK_APP_ID en fallback)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Pré-requis TikTok :
#   1. Créer une app sur https://developers.tiktok.com/apps
#   2. Activer le produit "Content Posting API"
#   3. Passer la review pour les scopes `video.upload` + `video.publish`
#   4. Ajouter `${NEXT_PUBLIC_APP_URL}/api/auth/tiktok` dans les
#      "Redirect URI" du SDK Login Kit
#   5. (Recommandé) Vérifier le domaine R2 public dans "URL ownership
#      verification" pour activer `PULL_FROM_URL` — sinon le service
#      bascule automatiquement sur `FILE_UPLOAD` chunké (plus lent).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Cloudflare R2 (optionnel — fallback local si absent)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME="influenceuse-ia"
R2_PUBLIC_URL=

# Redis
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────
# v0.12 — Trends intelligence (TikTok / Instagram)
# ──────────────────────────────────────────────
# The /trends dashboard surfaces actionable TikTok / Instagram trends and the
# /api/cron/fetch-trends route refreshes the cache once a day. The pipeline
# degrades gracefully: if no provider is configured the UI shows a
# "Trends not configured" banner and the cron returns
# `{ ok: true, skipped: "no-provider-configured" }`.
#
# Choose ONE provider via TRENDS_PROVIDER (auto-resolution also works):
#   - "apify"  → real TikTok + Instagram hashtag trends (recommended for prod)
#   - "http"   → call any HTTP endpoint that returns `RawTrendItem[]`
#   - "stub"   → dev-only demo data (NODE_ENV != production)
# If TRENDS_PROVIDER is empty we auto-pick the first configured one,
# falling back to "stub" in development.
TRENDS_PROVIDER=

# ──────── Apify provider (recommended) ────────
# https://apify.com — sign up, then grab a token at
#   https://console.apify.com/account/integrations
# A single APIFY_TOKEN unlocks both sub-fetchers (TikTok + Instagram).
# Pricing tip: the daily cron runs once thanks to the 24h cache, so most
# users stay under $1/month at default volumes.
# ──────── Apify billing (pay-as-you-go) ────────
# Starter ($29/mo) includes usage credits; enable overage in Console → Billing → Limits
# if you hit "Monthly usage hard limit exceeded". Free plan blocks until next cycle.
# APIFY_TOKEN=

# Override the TikTok hashtag-stats actor (Creative Center trending tags).
# Default: khadinakbar/tiktok-trending-hashtags-scraper (pay-per-use, no Store rent).
# Legacy (requires monthly actor rent): scrapeengine/tiktok-trending-hashtags-scraper
# APIFY_TIKTOK_ACTOR=khadinakbar/tiktok-trending-hashtags-scraper
# Individual TikTok videos under trending hashtags (default: clockworks/tiktok-scraper)
# APIFY_TIKTOK_VIDEO_ACTOR=clockworks/tiktok-scraper
# Set to false to skip TikTok video post scraping (hashtag signals only)
# APIFY_TIKTOK_VIDEOS=true
# Optional seed hashtags for TikTok video scraper (CSV). Falls back to trending tags + IG seeds.
# APIFY_TIKTOK_VIDEO_HASHTAGS=grwm,ootd,fashion,fitness

# Override the Instagram actor (default: apify/instagram-hashtag-scraper).
# Any Apify actor that takes `{ hashtags: string[], resultsType: "posts", resultsLimit: number }`
# and emits posts with caption + hashtags + likesCount + commentsCount works.
# APIFY_INSTAGRAM_ACTOR=apify/instagram-hashtag-scraper

# Two-letter country code for the TikTok Creative Center trending feed.
# Supported: US, GB, CA, FR, DE, ES, IT, BR, JP, KR, IN, AU, MX, AR, … (default: US).
# APIFY_TIKTOK_COUNTRY=US

# Look-back window for TikTok trends — "7", "30" or "120" days (default: 7).
# 7 = freshest signal for short-form planning; 30 = more stable rankings.
# APIFY_TIKTOK_PERIOD=7

# How many ranked trend items to keep after a fetch (default: 120, max 300).
# TRENDS_FETCH_LIMIT=120

# Drop scraped videos below this play/view count (default: 100000). Set 0 to disable.
# TRENDS_MIN_VIDEO_VIEWS=100000

# Seed hashtags for Instagram (Instagram has no official trending feed,
# so we scrape the most engaged posts under these tags and surface them
# as "what's working" signals). Default covers niches + viral tags.
# APIFY_INSTAGRAM_HASHTAGS=fashion,fitness,lifestyle,travel,food,ootd,grwm,reels,viral,beauty

# ──────── Generic HTTP provider (alternative) ────────
# Any backend that returns `RawTrendItem[]` (see
# src/server/services/trend-provider.ts for the shape) or `{ items: [...] }`.
# Useful if you self-host a scraper or use a competitor of Apify.
TRENDS_HTTP_URL=
TRENDS_HTTP_TOKEN=
