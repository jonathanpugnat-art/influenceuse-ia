# Base de données
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influenceuse"

# Clerk (authentification)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/fr/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/fr/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENCRYPTION_SECRET=
CRON_SECRET=

# DeepSeek (génération de texte — compatible API OpenAI)
DEEPSEEK_API_KEY=

# Replicate (génération d'images et vidéos)
REPLICATE_API_TOKEN=

# Stripe (paiements)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=

# Cloudflare R2 (optionnel — fallback local si absent)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME="influenceuse-ia"
R2_PUBLIC_URL=

# Redis
REDIS_URL="redis://localhost:6379"
