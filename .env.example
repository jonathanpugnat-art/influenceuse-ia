# Base de données
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influenceuse"

# Clerk (authentification)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/fr/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/fr/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENCRYPTION_SECRET=
CRON_SECRET=

# DeepSeek (génération de texte — compatible API OpenAI)
DEEPSEEK_API_KEY=

# Anthropic (provider texte alternatif — fidélité JSON Plan / Idées)
ANTHROPIC_API_KEY=
# Optionnel : modèle Claude utilisé (défaut: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Provider de texte par défaut (deepseek | anthropic). Défaut = deepseek.
# AI_TEXT_PROVIDER=deepseek

# Replicate (génération d'images et vidéos)
REPLICATE_API_TOKEN=
# Optionnel — modèle vidéo Replicate (override global)
# Valeurs : minimax/video-01 | kwaivgi/kling-v2.0 | wan-video/wan-2.5-i2v | runwayml/gen4-aleph
# REPLICATE_VIDEO_MODEL=minimax/video-01
# Optionnel — override par preset (priorité plus haute que REPLICATE_VIDEO_MODEL)
# REPLICATE_VIDEO_MODEL_STABLE_FACE=kwaivgi/kling-v2.0
# REPLICATE_VIDEO_MODEL_NATURAL_MOTION=minimax/video-01
# REPLICATE_VIDEO_MODEL_CREATIVE=runwayml/gen4-aleph
# Optionnel — Sprint 10: post-process lip-sync (preset reelStylePreset=lip_sync)
# REPLICATE_LIPSYNC_MODEL=sync/sync-1.6.0

# Stripe (paiements) — un Price ID par plan payant
# STARTER (Aura.AI Starter)  29 €/mois
# PRO     (Aura.AI Pro)      79 €/mois
# ENTERPRISE (Aura.AI Elite) 199 €/mois
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=
# Sprint 7 — Add-ons : packs de crédits (achat unique)
STRIPE_CREDIT_PACK_SMALL_PRICE_ID=
STRIPE_CREDIT_PACK_MEDIUM_PRICE_ID=
STRIPE_CREDIT_PACK_LARGE_PRICE_ID=

# Cloudflare R2 (optionnel — fallback local si absent)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME="influenceuse-ia"
R2_PUBLIC_URL=

# Redis
REDIS_URL="redis://localhost:6379"
