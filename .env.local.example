# Copie ce fichier en `.env.local` pour le dev local.
# `.env.local` écrase `.env` et n'est jamais commité.
#
# IMPORTANT : n'utilise PAS les clés pk_live_ / sk_live_ en local.
# Clerk Production refuse localhost avec l'erreur :
#   "Production Keys are only allowed for domain aurainfluenceai.com"

# Clerk — instance DEVELOPMENT du dashboard Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REMPLACE_MOI
CLERK_SECRET_KEY=sk_test_REMPLACE_MOI

# Doit correspondre au port de `npm run dev` (défaut 3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optionnel — garde les mêmes redirects qu'en prod
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/fr/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/fr/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/fr/influencers
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/fr/influencers
