{
  "name": "influenceuse-ia",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:node && vitest run",
    "test:node": "node --experimental-strip-types --test src/lib/scenes.test.ts src/lib/formats.test.ts src/lib/reels.test.ts src/lib/rate-limit.test.ts",
    "test:vitest": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:sql": "node --env-file=.env.local --env-file=.env --experimental-strip-types scripts/db-migrate-sql.ts",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "migrate:data": "node --env-file=.env.local --env-file=.env --import tsx scripts/migrate-data-to-cloud.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@clerk/localizations": "^4.19.0",
    "@clerk/nextjs": "^7.9.6",
    "@clerk/themes": "^2.4.57",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.1.0",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "inngest": "^4.21.0",
    "motion": "^13.4.6",
    "next": "^15.5.4",
    "posthog-js": "^1.434.18",
    "posthog-node": "^5.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.11",
    "inngest-cli": "^1.45.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
