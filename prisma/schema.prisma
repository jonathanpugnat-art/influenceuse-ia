// Influenceuse IA — Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // `directUrl` is only used by Prisma Migrate (build-time on Vercel).
  // The app runtime keeps reading `DATABASE_URL` (pooled via PgBouncer).
  // Falls back to DATABASE_URL when DIRECT_URL is not set (dev env).
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Niche {
  FASHION
  FITNESS
  LIFESTYLE
  TRAVEL
  TECH
  GAMING
  ADULT
  FOOD
}

enum Platform {
  TIKTOK
  INSTAGRAM
  ONLYFANS
}

enum InfluencerStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ContentType {
  PHOTO
  CAROUSEL
  REEL
  STORY
}

enum ContentMode {
  SFW
  NSFW
}

enum ContentStatus {
  DRAFT
  GENERATING
  READY
  SCHEDULED
  PUBLISHED
  FAILED
}

enum PublishStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GenerationType {
  BASE_IMAGE
  IMAGE
  VIDEO
  CAPTION
  HASHTAGS
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

/// Utilisateur de l'app (synchronisé avec Clerk)
model User {
  id                     String    @id @default(cuid())
  clerkId                String    @unique
  email                  String    @unique
  name                   String?
  imageUrl               String?
  plan                   Plan      @default(FREE)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  creditsUsed            Float     @default(0)
  creditsLimit           Float     @default(50)
  locale                 String    @default("fr")

  influencers    Influencer[]
  generationJobs GenerationJob[]
  webhooks       Webhook[]

  // Sprint 9 — B2B
  apiKeys              ApiKey[]
  ownedWorkspaces      Workspace[]       @relation("OwnedWorkspaces")
  workspaceMemberships WorkspaceMember[]
  referralsMade        Referral[]        @relation("ReferralsAsReferrer")
  referralReceived     Referral?         @relation("ReferralsAsReferred")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([email])
  @@index([stripeCustomerId])
}

/// Une influenceuse IA virtuelle
model Influencer {
  id           String           @id @default(cuid())
  userId       String
  name         String
  slug         String           @unique
  bio          String           @db.Text
  personality  String           @db.Text
  gender       String           @default("female")
  niche        Niche
  age          Int
  /// Stocke : { ethnicity, hairColor, hairStyle, bodyType, fashionStyle }
  style        Json
  /// Image de référence du visage pour la consistance
  baseImageUrl String?
  avatarUrl    String?
  isNsfw       Boolean          @default(false)
  status       InfluencerStatus @default(ACTIVE)

  user           User                 @relation(fields: [userId], references: [id])
  socialAccounts SocialAccount[]
  contents       Content[]
  contentBatches ContentBatch[]
  analytics      InfluencerAnalytics?
  trendRecommendations TrendRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([niche])
  @@index([slug])
  @@index([userId, status])
}

/// Compte social connecté à une influenceuse
model SocialAccount {
  id             String    @id @default(cuid())
  influencerId   String
  platform       Platform
  username       String
  /// ID utilisateur côté plateforme (ig_user_id, tiktok open_id, etc.)
  platformUserId String?
  /// Sera encrypté côté app
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  isConnected    Boolean   @default(false)
  followers      Int       @default(0)

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([influencerId, platform])
}

/// Un contenu généré (photo, carousel, reel)
model Content {
  id               String        @id @default(cuid())
  influencerId     String
  batchId          String?
  type             ContentType
  contentMode      ContentMode   @default(SFW)
  status           ContentStatus @default(DRAFT)
  caption          String?       @db.Text
  hashtags         String[]
  /// Plusieurs URLs pour carousel
  mediaUrls        String[]
  thumbnailUrl     String?
  promptUsed       String?       @db.Text
  negativePrompt   String?       @db.Text
  generationParams Json?
  platforms        Platform[]
  scheduledAt      DateTime?
  publishedAt      DateTime?

  influencer       Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  batch            ContentBatch?      @relation(fields: [batchId], references: [id])
  publishResults   PublishResult[]
  contentAnalytics ContentAnalytics[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([influencerId])
  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([influencerId, status])
  @@index([status, scheduledAt])
}

/// Lot de contenus générés ensemble
model ContentBatch {
  id           String @id @default(cuid())
  influencerId String
  name         String

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  contents   Content[]

  createdAt DateTime @default(now())
}

/// Résultat de publication par plateforme
model PublishResult {
  id             String        @id @default(cuid())
  contentId      String
  platform       Platform
  externalPostId String?
  status         PublishStatus @default(PENDING)
  error          String?
  publishedAt    DateTime?
  /// Données additionnelles (ex: onlyfans_download_url, tiktok_publish_id)
  metadata       Json?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/// Métriques par contenu par plateforme
model ContentAnalytics {
  id             String   @id @default(cuid())
  contentId      String
  platform       Platform
  views          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  saves          Int      @default(0)
  engagementRate Float    @default(0)
  fetchedAt      DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, platform, fetchedAt])
}

/// Stats agrégées par influenceuse (1-to-1)
model InfluencerAnalytics {
  id               String @id @default(cuid())
  influencerId     String @unique
  totalContents    Int    @default(0)
  totalViews       Int    @default(0)
  totalLikes       Int    @default(0)
  avgEngagement    Float  @default(0)
  estimatedRevenue Float  @default(0)

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

/// Jobs de génération IA en attente/en cours
model GenerationJob {
  id           String         @id @default(cuid())
  userId       String
  influencerId String
  contentId    String?
  type         GenerationType
  status       JobStatus      @default(PENDING)
  prompt       String         @db.Text
  parameters   Json?
  resultUrl    String?
  error        String?
  creditsUsed  Float          @default(1)
  startedAt    DateTime?
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
}

// ──────────────────────────────────────────────
// Webhooks sortants (Phase 5 — Distribution)
// ──────────────────────────────────────────────

enum WebhookEvent {
  CONTENT_PUBLISHED
  CONTENT_FAILED
  BATCH_COMPLETED
  CONTENT_SCHEDULED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

/// Webhook sortant configuré par l'utilisateur (Zapier, n8n, custom backend, etc.)
model Webhook {
  id            String         @id @default(cuid())
  userId        String
  name          String
  url           String
  /// HMAC-SHA256 secret partagé pour signer le payload
  secret        String
  events        WebhookEvent[]
  isActive      Boolean        @default(true)
  failureCount  Int            @default(0)
  lastFailedAt  DateTime?
  lastSuccessAt DateTime?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

// ──────────────────────────────────────────────
// Sprint 9 — Scale & B2B
// ──────────────────────────────────────────────

enum ApiKeyScope {
  READ
  WRITE
  ADMIN
}

/// Clé d'API publique pour automation (B2B Sprint 9)
/// Le `key` stocké est un hash SHA-256, jamais la clé en clair.
model ApiKey {
  id                 String        @id @default(cuid())
  userId             String
  name               String
  /// Préfixe public visible dans la liste (ex: "iia_live_a1b2c3"), sert d'identifiant rapide
  prefix             String        @unique
  /// Hash SHA-256 de la clé complète. La clé claire n'est jamais re-affichée après création.
  hashedKey          String        @unique
  scopes             ApiKeyScope[]
  isActive           Boolean       @default(true)
  lastUsedAt         DateTime?
  /// Compteur incrémentiel pour rate limiting léger (reset par cron / window)
  requestsThisWindow Int           @default(0)
  windowStartedAt    DateTime      @default(now())
  expiresAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([prefix])
  @@index([isActive])
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

/// Workspace = client géré (Agency mode)
model Workspace {
  id          String  @id @default(cuid())
  /// User propriétaire (créateur du workspace, plan Agency requis)
  ownerId     String
  name        String
  slug        String  @unique
  description String? @db.Text

  owner   User              @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  invitedBy   String?
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum MediaAssetKind {
  IMAGE
  VIDEO
  AUDIO
  PRESET
}

/// Catalogue d'assets ré-utilisables (Sprint 9 — Media Library)
model MediaAsset {
  id           String         @id @default(cuid())
  userId       String
  /// Optionnel: scope l'asset à un influenceur précis. NULL = global au compte.
  influencerId String?
  name         String
  kind         MediaAssetKind
  url          String
  thumbnailUrl String?
  /// Tags libres pour la recherche ("sunset", "studio", "outfit-1", etc.)
  tags         String[]
  /// Taille en octets (pour quotas / display).
  sizeBytes    Int?
  /// Métadonnées libres : dimensions, prompt, palette dominante…
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, kind])
  @@index([influencerId])
}

enum ReferralStatus {
  PENDING
  CONVERTED
  REWARDED
}

/// Referral program (Sprint 9 — Growth)
/// Chaque user a un code unique. Quand un nouveau user s'inscrit avec ce code,
/// on crée un Referral PENDING. À la 1ère sub, il devient REWARDED et on
/// crédite les 2 parties.
model Referral {
  id            String         @id @default(cuid())
  /// Le user qui parraine
  referrerId    String
  /// Le user parrainé (NULL tant que le filleul n'a pas signup)
  referredId    String?        @unique
  /// Code unique partagé publiquement
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  /// Crédits attribués au referrer une fois converti
  rewardCredits Int            @default(50)
  convertedAt   DateTime?
  rewardedAt    DateTime?

  referrer User  @relation("ReferralsAsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferralsAsReferred", fields: [referredId], references: [id])

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@index([code])
  @@index([status])
}

/// Trace d'une tentative de livraison de webhook
model WebhookDelivery {
  id           String                @id @default(cuid())
  webhookId    String
  event        WebhookEvent
  /// Payload envoyé (pour debug et retry)
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?
  responseBody String?               @db.Text
  error        String?               @db.Text
  attempts     Int                   @default(0)
  /// Prochaine tentative (NULL = pas de retry prévu)
  nextRetryAt  DateTime?
  deliveredAt  DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([status, nextRetryAt])
}

// Waitlist (beta gating). Anyone can subscribe via /api/waitlist; the
// owner promotes entries to "INVITED" from /admin/waitlist, which then
// triggers a Clerk invitation email. Used during the v0.11 closed beta —
// once the funnel is stable we either flip the flag and let signups in
// freely, or keep the waitlist as an "early access" UX.
model WaitlistEntry {
  id        String              @id @default(cuid())
  /// Stored lowercase + trimmed; unique to dedupe re-signups.
  email     String              @unique
  /// Free-form display name from the landing form. Optional.
  name      String?
  /// Marketing source: landing-hero, landing-cta, twitter, ph, etc.
  source    String?
  status    WaitlistEntryStatus @default(PENDING)
  /// When an admin clicks "Invite", we store the Clerk invitation id so
  /// we can match the eventual sign-up back to its waitlist entry.
  clerkInvitationId String?
  invitedAt DateTime?
  signedUpAt DateTime?
  /// IP captured at submission time, used by the rate-limiter and to
  /// chase obvious spam waves. Truncated to /24 for IPv4 and /48 for IPv6.
  ip        String?
  /// Free-form note an admin can write next to an entry (priority, source).
  note      String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum WaitlistEntryStatus {
  PENDING
  INVITED
  SIGNED_UP
  REJECTED
}

// ──────────────────────────────────────────────
// Trends (v0.12 — TikTok / Instagram trend intelligence)
// ──────────────────────────────────────────────
//
// Pipeline:
//   1. Cron `/api/cron/fetch-trends` calls a configurable TrendsProvider
//      (Apify, Predis, custom HTTP feed…) every day. The raw provider payload
//      is stored once as a `TrendSnapshot` (deduped by content hash) so we
//      can re-run analysis later without re-paying the provider.
//   2. Each snapshot is normalized into N `TrendItem` rows. These are
//      platform/region/niche-aware and are the rows we expose in the UI.
//   3. Per-influencer LLM personalization produces `TrendRecommendation`
//      rows: actionable photo/reel params (scene/pose/outfit…) the user can
//      apply in 1 click to the content creator.
//
// We intentionally never store identifiable third-party usernames in the
// recommendation — only short, source-agnostic citations like "trend_title"
// or "hashtag #foo" so prompts stay reproducible and safe.

/// One raw fetch from a TrendsProvider, deduped by content hash so the cron
/// can run frequently without exploding the table. Keep `rawPayload` for
/// audit + re-analysis.
model TrendSnapshot {
  id          String   @id @default(cuid())
  /// Which platform the data is about — TIKTOK / INSTAGRAM (ONLYFANS unused).
  platform    Platform
  /// Optional region code (e.g. "FR", "US", "global"). NULL = provider didn't
  /// expose a region (some feeds are language-only).
  region      String?
  /// ISO-639-1 locale (fr/en/…) when the provider returns localized data.
  locale      String?
  /// Identifier of the provider implementation that produced this snapshot.
  /// Lets us A/B providers without losing history.
  provider    String
  /// Raw JSON from the provider, kept for debug and re-analysis.
  rawPayload  Json
  /// SHA-256 of the canonical raw payload — used to dedupe identical fetches.
  contentHash String
  fetchedAt   DateTime @default(now())

  items TrendItem[]

  @@unique([provider, platform, contentHash])
  @@index([platform, fetchedAt])
  @@index([fetchedAt])
}

/// One normalized trend item — what the UI actually shows.
/// Denormalized from the snapshot so we can index/filter without joins.
model TrendItem {
  id            String   @id @default(cuid())
  snapshotId    String
  platform      Platform
  /// Short headline for the trend, e.g. "Get-ready-with-me running edition".
  title         String   @db.Text
  /// 1-3 sentence description. May be empty for hashtag-only signals.
  description   String?  @db.Text
  /// Hashtags WITHOUT the leading '#'.
  hashtags      String[]
  /// Trending audio / song name when the provider exposes one. Null otherwise.
  soundName     String?
  /// 0..100 score from the provider (or normalized in service).
  growthScore   Float?
  /// Where the trend lives publicly (TikTok discover URL, IG explore tag…).
  sourceUrl     String?
  /// Coarse niche tag inferred at fetch time, used for filtering.
  /// We don't FK to the Niche enum because some trends are cross-niche.
  /// Valid values: Niche enum keys ("FASHION", "FITNESS"…) + "GENERAL".
  nicheTags     String[]
  /// NSFW flag from the provider (or inferred by service heuristic).
  isNsfw        Boolean  @default(false)
  /// Locale of the trend, when known (fr / en / …).
  locale        String?
  /// Optional region for filtering (FR, US, global…).
  region        String?
  /// When this trend should be considered stale and hidden from the feed.
  /// NULL = no expiry (still up to `fetchedAt` recency to decide).
  expiresAt     DateTime?
  fetchedAt     DateTime @default(now())

  snapshot       TrendSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  recommendations TrendRecommendation[]

  @@index([platform])
  @@index([fetchedAt])
  @@index([platform, isNsfw, fetchedAt])
  @@index([snapshotId])
}

/// Per-influencer LLM-personalized recommendation derived from a TrendItem.
/// Multiple influencers can share the same TrendItem but each gets its own
/// recommendation (different niche/voice/NSFW gating).
model TrendRecommendation {
  id              String   @id @default(cuid())
  influencerId    String
  trendItemId     String
  /// Short scroll-stopping hook in the influencer's voice/language.
  generatedHook   String   @db.Text
  /// Structured JSON ready to feed into the photo/reel creator:
  ///   { type, platform, scene, pose, expression, outfit, customPrompt,
  ///     confidence, citations }
  /// Always validated against `trendRecommendationFieldsSchema` at write time.
  generatedFields Json
  /// Which LLM produced this (e.g. "deepseek-chat", "claude-sonnet-4-5").
  llmModel        String
  /// User dismissed this card — don't show it again.
  userDismissed   Boolean  @default(false)
  createdAt       DateTime @default(now())

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  trendItem  TrendItem  @relation(fields: [trendItemId], references: [id], onDelete: Cascade)

  @@unique([influencerId, trendItemId])
  @@index([influencerId])
  @@index([influencerId, userDismissed])
  @@index([createdAt])
}
