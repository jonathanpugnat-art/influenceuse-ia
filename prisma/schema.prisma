// Influenceuse IA — Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Niche {
  FASHION
  FITNESS
  LIFESTYLE
  TRAVEL
  TECH
  GAMING
  ADULT
  FOOD
}

enum Platform {
  TIKTOK
  INSTAGRAM
  ONLYFANS
}

enum InfluencerStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ContentType {
  PHOTO
  CAROUSEL
  REEL
  STORY
}

enum ContentMode {
  SFW
  NSFW
}

enum ContentStatus {
  DRAFT
  GENERATING
  READY
  SCHEDULED
  PUBLISHED
  FAILED
}

enum PublishStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GenerationType {
  BASE_IMAGE
  IMAGE
  VIDEO
  CAPTION
  HASHTAGS
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LoraStatus {
  NONE
  TRAINING
  READY
  FAILED
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

/// Utilisateur de l'app (synchronisé avec Clerk)
model User {
  id                     String    @id @default(cuid())
  clerkId                String    @unique
  email                  String    @unique
  name                   String?
  imageUrl               String?
  plan                   Plan      @default(FREE)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  creditsUsed            Float     @default(0)
  creditsLimit           Float     @default(50)
  /**
   * Crédits acquis hors plan (packs one-shot, rewards referral). Persistés
   * séparément pour que les changements de plan (checkout, upgrade,
   * downgrade, cancel) recalculent creditsLimit = planLimit + bonusCredits
   * au lieu d'écraser ce que l'utilisateur a payé.
   */
  bonusCredits           Float     @default(0)
  locale                 String    @default("fr")

  influencers    Influencer[]
  generationJobs GenerationJob[]
  webhooks       Webhook[]

  // Sprint 9 — B2B
  apiKeys              ApiKey[]
  ownedWorkspaces      Workspace[]       @relation("OwnedWorkspaces")
  workspaceMemberships WorkspaceMember[]
  referralsMade        Referral[]        @relation("ReferralsAsReferrer")
  referralReceived     Referral?         @relation("ReferralsAsReferred")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([email])
  @@index([stripeCustomerId])
}

/// Une influenceuse IA virtuelle
model Influencer {
  id           String           @id @default(cuid())
  userId       String
  name         String
  slug         String           @unique
  bio          String           @db.Text
  /// Brief narratif complet généré par l'agent wizard —
  /// décrit le positionnement, la personnalité, le but et la vision contenu.
  /// Utilisé comme contexte dans tous les agents en aval.
  brief        String?          @db.Text
  /// Profil de niche structuré produit par l'agent "cerveau de niche"
  /// (voir NicheProfile dans src/lib/niche-profile.ts). Pilote le rendu
  /// réaliste spécifique à la niche dans la génération photo/contenu.
  nicheProfile Json?
  personality  String           @db.Text
  gender       String           @default("female")
  niche        Niche
  age          Int
  /// Stocke : { ethnicity, hairColor, hairStyle, bodyType, fashionStyle }
  style        Json
  /// Image de référence du visage pour la consistance
  baseImageUrl String?
  avatarUrl    String?
  isNsfw       Boolean          @default(false)
  status       InfluencerStatus @default(ACTIVE)
  /// Indices into APPEARANCE_VARIATIONS (image-prompts.ts) — random subtle
  /// traits (face shape, eye color, expression…) baked into the base prompt
  /// so two users with identical style/age never get the same influencer.
  appearanceVariations Json?
  /// 8-char FNV-1a hash of (style + age + appearanceVariations). Indexed so
  /// we can detect near-duplicate influencers across users in O(1).
  appearanceFingerprint String?
  /// Multi-angle 2D reference stills (see `IdentityPackRecord` in identity-pack.ts).
  identityPack          Json?
  /// Character LoRA weights URL (FLUX) when training succeeded.
  loraUrl               String?
  loraStatus            LoraStatus @default(NONE)
  /// Trigger token baked into prompts when LoRA is active (e.g. AURA_x7k2m9).
  loraTriggerWord       String?
  loraTrainedAt         DateTime?
  /// Async training job id (FAL / Replicate) while status = TRAINING.
  loraTrainingJobId     String?
  /// Dataset metadata: { status, imageUrls[], zipUrl?, error? }
  loraDataset           Json?

  user           User                 @relation(fields: [userId], references: [id])
  socialAccounts SocialAccount[]
  contents       Content[]
  contentBatches ContentBatch[]
  analytics      InfluencerAnalytics?
  trendRecommendations TrendRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([niche])
  @@index([slug])
  @@index([userId, status])
  @@index([appearanceFingerprint])
}

/// Portrait de base pré-généré, proposé dans la galerie du wizard (étape 2).
/// L'utilisateur choisit une base au lieu de générer from scratch — cohérence
/// et onboarding plus rapides. Peuplé hors-ligne via scripts/seed-base-portraits.ts.
model BasePortrait {
  id           String   @id @default(cuid())
  niche        Niche
  gender       String   @default("female")
  ethnicity    String
  bodyType     String
  imageUrl     String
  thumbnailUrl String?
  isNsfw       Boolean  @default(false)
  /// Mots-clés de positionnement ("premium", "soft", "sporty"…) — servent au
  /// matching avec le brief Aura pour mettre en avant les bases pertinentes.
  tags         String[]
  active       Boolean  @default(true)
  /// Tri manuel optionnel (plus petit = affiché en premier).
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([niche, gender, active])
  @@index([active, isNsfw])
}

/// Compte social connecté à une influenceuse
model SocialAccount {
  id             String    @id @default(cuid())
  influencerId   String
  platform       Platform
  username       String
  /// ID utilisateur côté plateforme (ig_user_id, tiktok open_id, etc.)
  platformUserId String?
  /// Sera encrypté côté app
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  /// instagram_login | facebook_login — how the token was obtained (refresh differs).
  oauthProvider  String?
  /// OAuth scopes granted by the user (e.g. instagram_business_content_publish,
  /// video.publish). Persisted so we can detect what the token can do without
  /// re-querying the platform every publish.
  scopes         String[]  @default([])
  /// TikTok Direct Post: privacy options the account is allowed to pick from
  /// (PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, SELF_ONLY, ...). Fetched via
  /// /v2/post/publish/creator_info/query/ and cached to power the composer.
  /// Sandbox / un-audited apps typically only get ["SELF_ONLY"].
  privacyOptions Json?
  isConnected    Boolean   @default(false)
  followers      Int       @default(0)

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([influencerId, platform])
}

/// Un contenu généré (photo, carousel, reel)
model Content {
  id               String        @id @default(cuid())
  influencerId     String
  batchId          String?
  type             ContentType
  contentMode      ContentMode   @default(SFW)
  status           ContentStatus @default(DRAFT)
  caption          String?       @db.Text
  hashtags         String[]
  /// Plusieurs URLs pour carousel
  mediaUrls        String[]
  thumbnailUrl     String?
  promptUsed       String?       @db.Text
  negativePrompt   String?       @db.Text
  generationParams Json?
  platforms        Platform[]
  scheduledAt      DateTime?
  publishedAt      DateTime?

  // ── Social Publish V1 (IG Reels + TikTok Direct Post) ─────────────────
  /// Whether Aura declared this asset as AI-generated to the destination
  /// platform. Always true in V1 (`is_ai_generated=true` for IG Reels,
  /// `is_aigc=true` for TikTok). Never opt-out. Kept as a column so the
  /// audit log stays trivial to query.
  isAiGenerated    Boolean            @default(true)
  /// Optional first comment posted right after IG publish. Best-effort:
  /// if the comments scope is missing / blocked, we silently skip.
  firstComment     String?            @db.Text
  /// IG Reels only — mirror the reel on the account feed (default true).
  shareToFeed      Boolean            @default(true)
  /// TikTok Direct Post privacy — must be one of the values returned by
  /// creator_info.privacy_level_options. Un-audited apps are locked to
  /// SELF_ONLY (enforced server-side).
  tiktokPrivacyLevel String?
  /// Meta media id returned by /media_publish. Populated on IG success.
  igMediaId        String?
  /// TikTok Direct Post `publish_id` returned by /video/init. Populated
  /// on TikTok init success (the final post id is checked later via the
  /// status endpoint if we ever need it).
  tiktokPublishId  String?

  influencer       Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  batch            ContentBatch?      @relation(fields: [batchId], references: [id])
  publishResults   PublishResult[]
  contentAnalytics ContentAnalytics[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([influencerId])
  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([influencerId, status])
  @@index([status, scheduledAt])
}

/// Lot de contenus générés ensemble
model ContentBatch {
  id           String @id @default(cuid())
  influencerId String
  name         String

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  contents   Content[]

  createdAt DateTime @default(now())
}

/// Résultat de publication par plateforme
model PublishResult {
  id             String        @id @default(cuid())
  contentId      String
  platform       Platform
  externalPostId String?
  status         PublishStatus @default(PENDING)
  error          String?
  publishedAt    DateTime?
  /// Données additionnelles (ex: onlyfans_download_url, tiktok_publish_id)
  metadata       Json?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/// Métriques par contenu par plateforme
model ContentAnalytics {
  id             String   @id @default(cuid())
  contentId      String
  platform       Platform
  views          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  saves          Int      @default(0)
  engagementRate Float    @default(0)
  fetchedAt      DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, platform, fetchedAt])
}

/// Stats agrégées par influenceuse (1-to-1)
model InfluencerAnalytics {
  id               String @id @default(cuid())
  influencerId     String @unique
  totalContents    Int    @default(0)
  totalViews       Int    @default(0)
  totalLikes       Int    @default(0)
  avgEngagement    Float  @default(0)
  estimatedRevenue Float  @default(0)

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

/// Jobs de génération IA en attente/en cours
model GenerationJob {
  id           String         @id @default(cuid())
  userId       String
  influencerId String
  contentId    String?
  type         GenerationType
  status       JobStatus      @default(PENDING)
  prompt       String         @db.Text
  parameters   Json?
  resultUrl    String?
  error        String?
  creditsUsed  Float          @default(1)
  startedAt    DateTime?
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
}

// ──────────────────────────────────────────────
// Webhooks sortants (Phase 5 — Distribution)
// ──────────────────────────────────────────────

enum WebhookEvent {
  CONTENT_PUBLISHED
  CONTENT_FAILED
  BATCH_COMPLETED
  CONTENT_SCHEDULED
  REMIX_COMPLETED
  REMIX_FAILED
}

/// Viral remix job — user pastes/uploads a TikTok/Reel clip and the
/// locked character replays the move. Kling O3 video-to-video + elements.
/// Kept in its own table so the FAL webhook can look up by request_id fast
/// and so credit-hold / refund logic stays self-contained.
enum RemixJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  REFUNDED
}

model RemixJob {
  id                  String         @id @default(cuid())
  userId              String
  influencerId        String
  /// "standard" | "pro" — matches REMIX_TIERS in lib/remix-config.
  tier                String         @default("standard")
  /// 5 | 10 | 15 — server-clamped to source duration and max 15.
  durationSec         Int
  /// Original clip duration reported by the client (seconds). Used to clamp
  /// duration and for the pre-generate cost preview reconciliation.
  sourceDurationSec   Float?
  /// Public URL of the uploaded source MP4/MOV (already on our R2).
  sourceVideoUrl      String
  /// Frontal still URL passed as the first `elements[]` reference. Required.
  frontalImageUrl     String
  /// 0-3 additional identity references (3/4, full body, profile…). At most
  /// 3 URLs so `elements + image_urls` stays within Kling's cap of 4.
  referenceImageUrls  String[]       @default([])
  /// Preserve original source audio in the output.
  keepAudio           Boolean        @default(true)
  /// Prompt sent to Kling. Persisted for debugging + reproducibility.
  prompt              String         @db.Text
  /// Credits held on queue (deducted on createRemix). Refunded on FAILED.
  creditsHeld         Int            @default(0)
  status              RemixJobStatus @default(PENDING)
  /// FAL queue `request_id` — the FAL webhook uses this to look us up.
  falRequestId        String?        @unique
  /// FAL model id we submitted to (kept for retries / audit).
  falModel            String
  /// Optional oEmbed preview payload captured from the URL field.
  /// { title, authorName, thumbnailUrl, providerName, url } — display only.
  oembedPreview       Json?
  /// Final R2 URL for the produced 9:16 MP4.
  outputVideoUrl      String?
  /// Short human-readable error for FAILED jobs.
  error               String?
  /// Free-form FAL payload / metadata for future audit.
  metadata            Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  completedAt         DateTime?

  @@index([userId])
  @@index([influencerId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

/// Webhook sortant configuré par l'utilisateur (Zapier, n8n, custom backend, etc.)
model Webhook {
  id            String         @id @default(cuid())
  userId        String
  name          String
  url           String
  /// HMAC-SHA256 secret partagé pour signer le payload
  secret        String
  events        WebhookEvent[]
  isActive      Boolean        @default(true)
  failureCount  Int            @default(0)
  lastFailedAt  DateTime?
  lastSuccessAt DateTime?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

// ──────────────────────────────────────────────
// Sprint 9 — Scale & B2B
// ──────────────────────────────────────────────

enum ApiKeyScope {
  READ
  WRITE
  ADMIN
}

/// Clé d'API publique pour automation (B2B Sprint 9)
/// Le `key` stocké est un hash SHA-256, jamais la clé en clair.
model ApiKey {
  id                 String        @id @default(cuid())
  userId             String
  name               String
  /// Préfixe public visible dans la liste (ex: "iia_live_a1b2c3"), sert d'identifiant rapide
  prefix             String        @unique
  /// Hash SHA-256 de la clé complète. La clé claire n'est jamais re-affichée après création.
  hashedKey          String        @unique
  scopes             ApiKeyScope[]
  isActive           Boolean       @default(true)
  lastUsedAt         DateTime?
  /// Compteur incrémentiel pour rate limiting léger (reset par cron / window)
  requestsThisWindow Int           @default(0)
  windowStartedAt    DateTime      @default(now())
  expiresAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([prefix])
  @@index([isActive])
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

/// Workspace = client géré (Agency mode)
model Workspace {
  id          String  @id @default(cuid())
  /// User propriétaire (créateur du workspace, plan Agency requis)
  ownerId     String
  name        String
  slug        String  @unique
  description String? @db.Text

  owner   User              @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  invitedBy   String?
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

enum MediaAssetKind {
  IMAGE
  VIDEO
  AUDIO
  PRESET
}

/// Catalogue d'assets ré-utilisables (Sprint 9 — Media Library)
model MediaAsset {
  id           String         @id @default(cuid())
  userId       String
  /// Optionnel: scope l'asset à un influenceur précis. NULL = global au compte.
  influencerId String?
  name         String
  kind         MediaAssetKind
  url          String
  thumbnailUrl String?
  /// Tags libres pour la recherche ("sunset", "studio", "outfit-1", etc.)
  tags         String[]
  /// Taille en octets (pour quotas / display).
  sizeBytes    Int?
  /// Métadonnées libres : dimensions, prompt, palette dominante…
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, kind])
  @@index([influencerId])
}

enum ReferralStatus {
  PENDING
  CONVERTED
  REWARDED
}

/// Referral program (Sprint 9 — Growth)
/// Chaque user a un code unique. Quand un nouveau user s'inscrit avec ce code,
/// on crée un Referral PENDING. À la 1ère sub, il devient REWARDED et on
/// crédite les 2 parties.
model Referral {
  id            String         @id @default(cuid())
  /// Le user qui parraine
  referrerId    String
  /// Le user parrainé (NULL tant que le filleul n'a pas signup)
  referredId    String?        @unique
  /// Code unique partagé publiquement
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  /// Crédits attribués au referrer une fois converti
  rewardCredits Int            @default(50)
  convertedAt   DateTime?
  rewardedAt    DateTime?

  referrer User  @relation("ReferralsAsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferralsAsReferred", fields: [referredId], references: [id])

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@index([code])
  @@index([status])
}

/// Événements webhook entrants (Stripe/Clerk) déjà traités — idempotence
/// sur les retries providers (un retry Stripe ne doit pas re-créditer un
/// pack de crédits, par ex.). `id` = event.id Stripe ou svix-id Clerk.
model ProcessedWebhookEvent {
  id        String   @id
  source    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Trace d'une tentative de livraison de webhook
model WebhookDelivery {
  id           String                @id @default(cuid())
  webhookId    String
  event        WebhookEvent
  /// Payload envoyé (pour debug et retry)
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?
  responseBody String?               @db.Text
  error        String?               @db.Text
  attempts     Int                   @default(0)
  /// Prochaine tentative (NULL = pas de retry prévu)
  nextRetryAt  DateTime?
  deliveredAt  DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([status, nextRetryAt])
}

// Waitlist (beta gating). Anyone can subscribe via /api/waitlist; the
// owner promotes entries to "INVITED" from /admin/waitlist, which then
// triggers a Clerk invitation email. Used during the v0.11 closed beta —
// once the funnel is stable we either flip the flag and let signups in
// freely, or keep the waitlist as an "early access" UX.
model WaitlistEntry {
  id        String              @id @default(cuid())
  /// Stored lowercase + trimmed; unique to dedupe re-signups.
  email     String              @unique
  /// Free-form display name from the landing form. Optional.
  name      String?
  /// Marketing source: landing-hero, landing-cta, twitter, ph, etc.
  source    String?
  status    WaitlistEntryStatus @default(PENDING)
  /// When an admin clicks "Invite", we store the Clerk invitation id so
  /// we can match the eventual sign-up back to its waitlist entry.
  clerkInvitationId String?
  invitedAt DateTime?
  signedUpAt DateTime?
  /// IP captured at submission time, used by the rate-limiter and to
  /// chase obvious spam waves. Truncated to /24 for IPv4 and /48 for IPv6.
  ip        String?
  /// Free-form note an admin can write next to an entry (priority, source).
  note      String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum WaitlistEntryStatus {
  PENDING
  INVITED
  SIGNED_UP
  REJECTED
}

// ──────────────────────────────────────────────
// Trends (v0.12 — TikTok / Instagram trend intelligence)
// ──────────────────────────────────────────────
//
// Pipeline:
//   1. Cron `/api/cron/fetch-trends` calls a configurable TrendsProvider
//      (Apify, Predis, custom HTTP feed…) every day. The raw provider payload
//      is stored once as a `TrendSnapshot` (deduped by content hash) so we
//      can re-run analysis later without re-paying the provider.
//   2. Each snapshot is normalized into N `TrendItem` rows. These are
//      platform/region/niche-aware and are the rows we expose in the UI.
//   3. Per-influencer LLM personalization produces `TrendRecommendation`
//      rows: actionable photo/reel params (scene/pose/outfit…) the user can
//      apply in 1 click to the content creator.
//
// We intentionally never store identifiable third-party usernames in the
// recommendation — only short, source-agnostic citations like "trend_title"
// or "hashtag #foo" so prompts stay reproducible and safe.

/// One raw fetch from a TrendsProvider, deduped by content hash so the cron
/// can run frequently without exploding the table. Keep `rawPayload` for
/// audit + re-analysis.
model TrendSnapshot {
  id          String   @id @default(cuid())
  /// Which platform the data is about — TIKTOK / INSTAGRAM (ONLYFANS unused).
  platform    Platform
  /// Optional region code (e.g. "FR", "US", "global"). NULL = provider didn't
  /// expose a region (some feeds are language-only).
  region      String?
  /// ISO-639-1 locale (fr/en/…) when the provider returns localized data.
  locale      String?
  /// Identifier of the provider implementation that produced this snapshot.
  /// Lets us A/B providers without losing history.
  provider    String
  /// Raw JSON from the provider, kept for debug and re-analysis.
  rawPayload  Json
  /// SHA-256 of the canonical raw payload — used to dedupe identical fetches.
  contentHash String
  fetchedAt   DateTime @default(now())

  items TrendItem[]

  @@unique([provider, platform, contentHash])
  @@index([platform, fetchedAt])
  @@index([fetchedAt])
}

/// One normalized trend item — what the UI actually shows.
/// Denormalized from the snapshot so we can index/filter without joins.
model TrendItem {
  id            String   @id @default(cuid())
  snapshotId    String
  platform      Platform
  /// Short headline for the trend, e.g. "Get-ready-with-me running edition".
  title         String   @db.Text
  /// 1-3 sentence description. May be empty for hashtag-only signals.
  description   String?  @db.Text
  /// Hashtags WITHOUT the leading '#'.
  hashtags      String[]
  /// Trending audio / song name when the provider exposes one. Null otherwise.
  soundName     String?
  /// 0..100 score from the provider (or normalized in service).
  growthScore   Float?
  /// Where the trend lives publicly (TikTok discover URL, IG explore tag…).
  sourceUrl     String?
  /// Visual preview URL — used as the hero image of the TrendCard.
  /// Stored separately from sourceUrl so providers without a thumbnail
  /// (e.g. raw Apify hashtag rows) can still ship a card; the UI falls
  /// back to a niche-coloured gradient when this is null.
  thumbnailUrl  String?
  /// Optional second representative thumbnail for hover-swap on the card.
  /// Curated trends ship 1-2 thumbnails; Apify will populate this from the
  /// top engagement post when available.
  thumbnailUrlAlt String?
  /// When set and the platform is TIKTOK or INSTAGRAM, the UI can render
  /// an embedded video player in the modal (TikTok oEmbed iframe / IG embed
  /// iframe). NULL means we link out to sourceUrl instead.
  embedUrl      String?
  /// Author / creator handle for attribution (e.g. "@charlidamelio") when
  /// the trend points to a specific public creator profile or post.
  /// Optional — most curated/aggregated trends don't have a single author.
  authorHandle  String?
  /// Coarse niche tag inferred at fetch time, used for filtering.
  /// We don't FK to the Niche enum because some trends are cross-niche.
  /// Valid values: Niche enum keys ("FASHION", "FITNESS"…) + "GENERAL".
  nicheTags     String[]
  /// NSFW flag from the provider (or inferred by service heuristic).
  isNsfw        Boolean  @default(false)
  /// Locale of the trend, when known (fr / en / …).
  locale        String?
  /// Optional region for filtering (FR, US, global…).
  region        String?
  /// When this trend should be considered stale and hidden from the feed.
  /// NULL = no expiry (still up to `fetchedAt` recency to decide).
  expiresAt     DateTime?
  /// Public media URLs from top scraped posts (images / video posters). Never
  /// sent to image models as identity reference — only analyzed for format.
  mediaUrls       String[] @default([])
  /// Persisted copy of the source trend MP4 (R2) for motion-control reels.
  sourceVideoUrl  String?
  /// Keyframe stills extracted from sourceVideoUrl for vision analysis.
  videoFrameUrls  String[] @default([])
  /// image | video | carousel | hashtag_signal (TikTok hashtag stats only).
  mediaKind       String?
  /// Vision/text-derived format inspiration (scene, reel storyboard, etc.).
  formatBrief       Json?
  formatAnalyzedAt  DateTime?
  formatAnalysisModel String?
  fetchedAt     DateTime @default(now())

  snapshot       TrendSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  recommendations TrendRecommendation[]

  @@index([platform])
  @@index([fetchedAt])
  @@index([platform, isNsfw, fetchedAt])
  @@index([snapshotId])
}

/// Per-influencer LLM-personalized recommendation derived from a TrendItem.
/// Multiple influencers can share the same TrendItem but each gets its own
/// recommendation (different niche/voice/NSFW gating).
model TrendRecommendation {
  id              String   @id @default(cuid())
  influencerId    String
  trendItemId     String
  /// Short scroll-stopping hook in the influencer's voice/language.
  generatedHook   String   @db.Text
  /// Structured JSON ready to feed into the photo/reel creator:
  ///   { type, platform, scene, pose, expression, outfit, customPrompt,
  ///     confidence, citations }
  /// Always validated against `trendRecommendationFieldsSchema` at write time.
  generatedFields Json
  /// Which LLM produced this (e.g. "deepseek-chat", "claude-sonnet-4-5").
  llmModel        String
  /// User dismissed this card — don't show it again.
  userDismissed   Boolean  @default(false)
  createdAt       DateTime @default(now())

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  trendItem  TrendItem  @relation(fields: [trendItemId], references: [id], onDelete: Cascade)

  @@unique([influencerId, trendItemId])
  @@index([influencerId])
  @@index([influencerId, userDismissed])
  @@index([createdAt])
}
