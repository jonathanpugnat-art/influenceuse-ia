{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && PRISMA_MIGRATE=1 npx prisma migrate deploy && npx next build",
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-batches",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retry-webhooks",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/fetch-analytics",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/fetch-trends",
      "schedule": "0 5 * * *"
    }
  ]
}
